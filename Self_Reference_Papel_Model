# Load libraries
library(ggplot2)
library(dplyr)

# Step 1: Read the CSV file
data <- read.csv("Paper_3_Dataset_42_Papers.csv", header = FALSE, stringsAsFactors = FALSE)

# Optional: Inspect raw data
print(head(data, 7))

# Step 2: Extract data, skipping first column (assumed to be labels/years)
# Row 2: Total Citations
# Row 4: Non-Self-Citations
# Row 6: Self-References
# Row 7: Non-Self-References
# Column 1 is ignored (Year or label), Columns 2+ are papers

# Extract paper names from Row 1, Columns 2+
paper_names <- as.character(data[1, -1])
paper_names <- trimws(paper_names)

# Helper function to safely convert to numeric
safe_numeric <- function(x) {
  x <- as.character(x)
  x[x %in% c("", "NA", "N/A", "n/a", "--", ".", " ")] <- NA
  as.numeric(x)
}

# Extract and convert each row
non_self_citations <- safe_numeric(data[4, -1])
self_refs          <- safe_numeric(data[6, -1])
non_self_refs      <- safe_numeric(data[7, -1])

# Step 3: Create data frame
df <- data.frame(
  Paper = paper_names,
  Non_Self_Citations  = non_self_citations,
  Self_References     = self_refs,
  Non_Self_References = non_self_refs
)

# Step 4: Remove rows with NA in numeric columns
df_clean <- df[complete.cases(df[, c("Non_Self_Citations", "Self_References", "Non_Self_References")]), ]

# Make sure numeric columns stay numeric
df_clean$Non_Self_Citations  <- as.numeric(df_clean$Non_Self_Citations)
df_clean$Self_References     <- as.numeric(df_clean$Self_References)
df_clean$Non_Self_References <- as.numeric(df_clean$Non_Self_References)

# Step 5: Display cleaned data
print("Cleaned Data Frame:")
print(df_clean, row.names = FALSE)

# Step 6: Run multiple linear regression
model <- lm(Non_Self_Citations ~ Self_References + Non_Self_References, data = df_clean)

# Show results
print("Regression Summary:")
print(summary(model))

# Tidy output (optional)
if (!require(broom)) install.packages("broom")
library(broom)
print(tidy(model))

# Step 7: Plots

# Plot 1: Non-Self-Citations vs Self-References
p1 <- ggplot(df_clean, aes(x = Self_References, y = Non_Self_Citations)) +
  geom_point(color = "steelblue") +
  geom_smooth(method = "lm", se = TRUE, color = "darkblue") +
  labs(title = "Non-Self-Citations vs Self-References",
       x = "Self-References", y = "Non-Self-Citations") +
  theme_minimal()

# Plot 2: Non-Self-Citations vs Non-Self-References
p2 <- ggplot(df_clean, aes(x = Non_Self_References, y = Non_Self_Citations)) +
  geom_point(color = "seagreen") +
  geom_smooth(method = "lm", se = TRUE, color = "darkgreen") +
  labs(title = "Non-Self-Citations vs Non-Self-References",
       x = "Non-Self-References", y = "Non-Self-Citations") +
  theme_minimal()

# Print plots
print(p1)
print(p2)

# Diagnostic plot: Residuals vs Fitted
plot(model, which = 1)

# Optional: Correlation (numeric only)
cat("\nCorrelation Matrix (numeric variables only):\n")
cor_numeric <- cor(df_clean[, c("Non_Self_Citations", "Self_References", "Non_Self_References")], use = "complete.obs")
print(cor_numeric)

# -------------------------------
# Step 1: Load required package
# -------------------------------
if (!require(car)) {
  install.packages("car")
}
library(car)

# -------------------------------
# Step 2: Check correlation between predictors
# -------------------------------
cat("\nVariance Inflation Factors (VIF):\n")
print(vif(model))

# -----------------------------------------------
# Step 8: Mann-Whitney U Test
# Self-References vs Non-Self-References
# -----------------------------------------------
cat("\nMann-Whitney U Test: Self-References vs Non-Self-References\n")

mw_result <- wilcox.test(df_clean$Self_References,
                         df_clean$Non_Self_References,
                         alternative = "two.sided",
                         exact = FALSE)

print(mw_result)

# Effect size r = 1 - (2U / n1*n2)
n1 <- length(df_clean$Self_References)
n2 <- length(df_clean$Non_Self_References)
r_effect <- 1 - (2 * mw_result$statistic) / (n1 * n2)
cat(sprintf("Effect size r: %.4f\n", r_effect))

# Descriptive statistics for both groups
cat("\nDescriptive Statistics:\n")
cat(sprintf("Self-References    — Mean: %.2f, Median: %.2f, SD: %.2f\n",
            mean(df_clean$Self_References),
            median(df_clean$Self_References),
            sd(df_clean$Self_References)))
cat(sprintf("Non-Self-References — Mean: %.2f, Median: %.2f, SD: %.2f\n",
            mean(df_clean$Non_Self_References),
            median(df_clean$Non_Self_References),
            sd(df_clean$Non_Self_References)))
